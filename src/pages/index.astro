---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Drafee",
  "url": "https://drafee.com",
  "description": "เครื่องมือออนไลน์ฟรีสำหรับคนไทย ครีเอเตอร์ และมืออาชีพ",
  "inLanguage": "th",
  "publisher": {
    "@type": "Organization",
    "name": "Drafee",
    "url": "https://drafee.com"
  }
});

const creatorTools = [
  {
    href: '/ig-line-break',
    icon: 'camera',
    title: 'เว้นบรรทัดแคปชั่น Instagram',
    desc: 'แทรก invisible character ให้แคปชั่น IG ขึ้นบรรทัดใหม่ได้จริง ไม่หายตอนโพสต์',
    badge: 'ฮิต',
    badgeColor: 'bg-purple-100 text-purple-700',
  },
  {
    href: '/character-counter',
    icon: 'hashtag',
    title: 'นับตัวอักษรทุกแพลตฟอร์ม',
    desc: 'นับแบบ real-time พร้อมแสดง limit ของ IG, X, TikTok, YouTube, Facebook, LINE OA ในหน้าเดียว',
    badge: '',
    badgeColor: '',
  },
  {
    href: '/engagement-rate',
    icon: 'chart-bar',
    title: 'คำนวณ Engagement Rate',
    desc: 'คำนวณ ER สำหรับ Instagram, TikTok, YouTube, Facebook พร้อม benchmark บอกว่าดี ปานกลาง หรือต่ำ',
    badge: 'ครีเอเตอร์',
    badgeColor: 'bg-pink-100 text-pink-700',
  },
];

const financeTools = [
  {
    href: '/vat-calculator',
    icon: 'receipt-percent',
    title: 'คำนวณ VAT 7%',
    desc: 'บวก VAT จากราคาก่อนภาษี หรือถอด VAT จากราคารวมภาษีแล้ว ได้ผลทันที',
    badge: '',
    badgeColor: '',
  },
  {
    href: '/transfer-fee-calculator',
    icon: 'home',
    title: 'คำนวณค่าโอนบ้าน & ที่ดิน',
    desc: 'แตกรายการค่าโอน 2%, ค่าจดจำนอง 1%, ภาษีธุรกิจเฉพาะ 3.3% หรืออากรแสตมป์ 0.5% ตามเงื่อนไขการถือครอง',
    badge: '',
    badgeColor: '',
  },
  {
    href: '/salary-calculator',
    icon: 'banknotes',
    title: 'คำนวณเงินเดือนสุทธิ',
    desc: 'หักประกันสังคม 5% และภาษีเงินได้หัก ณ ที่จ่าย สำหรับพนักงานประจำ ปีภาษี 2567',
    badge: '',
    badgeColor: '',
  },
  {
    href: '/income-tax-calculator',
    icon: 'scale',
    title: 'ภาษีเงินได้บุคคลธรรมดา',
    desc: 'คำนวณภาษีอัตราก้าวหน้า 0–35% ปีภาษี 2567 พร้อมค่าลดหย่อนครบ RMF SSF ประกันชีวิต บุตร',
    badge: '',
    badgeColor: '',
  },
  {
    href: '/currency-converter',
    icon: 'arrows-right-left',
    title: 'แปลงเงินตรา',
    desc: 'แปลง 11 สกุลเงิน บาทไทย ดอลลาร์ ยูโร ปอนด์ เยน หยวน สิงคโปร์ และอื่นๆ ได้ทันที',
    badge: '',
    badgeColor: '',
  },
  {
    href: '/severance-calculator',
    icon: 'briefcase',
    title: 'คำนวณเงินชดเชยเลิกจ้าง',
    desc: 'คำนวณตาม พ.ร.บ.คุ้มครองแรงงาน ม.118 พร้อมเงินว่างงานประกันสังคม',
    badge: '',
    badgeColor: '',
  },
  {
    href: '/withholding-tax-calculator',
    icon: 'calculator',
    title: 'คำนวณภาษีหัก ณ ที่จ่าย',
    desc: 'ฟรีแลนซ์คำนวณ WHT 3% + VAT 7% ได้เลย รองรับทั้งคำนวณตรงและย้อนกลับ (ต้องการรับสุทธิเท่าไร → ต้องเสนอราคาเท่าไร)',
    badge: 'ฟรีแลนซ์',
    badgeColor: 'bg-emerald-100 text-emerald-700',
  },
];

const funTools = [
  {
    href: '/date-invite/create',
    icon: 'heart',
    title: 'ชวนแฟนไปเดท',
    desc: 'สร้างลิงก์น่ารักๆ ส่งให้แฟนตอบคำถามทีละข้อ พร้อมอีเมลแจ้งเตือนทันทีที่ตอบเสร็จ',
    badge: 'ใหม่',
    badgeColor: 'bg-pink-100 text-pink-700',
  },
];

const generalTools = [
  {
    href: '/land-converter',
    icon: 'squares-2x2',
    title: 'แปลงหน่วยที่ดิน',
    desc: 'แปลง ไร่ งาน ตร.วา ตร.ม. ตร.ฟุต เฮกตาร์ เอเคอร์ ใส่ค่าหน่วยใดก็ได้ ได้ทุกหน่วยทันที',
    badge: '',
    badgeColor: '',
  },
  {
    href: '/date-calculator',
    icon: 'calendar',
    title: 'นับวัน / คำนวณอายุ',
    desc: 'นับจำนวนวันระหว่างสองวัน หรือคำนวณอายุจากวันเกิด บอกทั้งวัน เดือน ปี และวันเกิดครั้งถัดไป',
    badge: '',
    badgeColor: '',
  },
];
---

<Layout
  title="Drafee — เครื่องมือออนไลน์ฟรีสำหรับคนไทย ครีเอเตอร์ และฟรีแลนซ์"
  description="เครื่องมือออนไลน์ฟรีภาษาไทย ทั้งเว้นบรรทัด IG นับตัวอักษร คำนวณค่าโอนบ้าน เงินชดเชย และภาษีหัก ณ ที่จ่าย ใช้งานได้เลยไม่ต้องสมัครสมาชิก"
  schemaJson={schema}
>

  <!-- Hero -->
  <section class="bg-gradient-to-b from-teal-50 via-cyan-50 to-white py-14 text-center">
    <div class="mx-auto max-w-2xl px-4">
      <div class="inline-flex items-center gap-2 rounded-full bg-teal-100 px-4 py-1.5 text-xs font-semibold text-teal-700 mb-4">
        ✦ เครื่องมือทั้งหมดฟรี · ไม่ต้องสมัครสมาชิก
      </div>
      <h1 class="text-3xl font-extrabold leading-snug text-gray-900 sm:text-4xl">
        เครื่องมือออนไลน์ฟรี<br/>สำหรับคนไทย
      </h1>
      <p class="mt-4 text-base text-gray-600 leading-relaxed">
        รวมเครื่องมือที่ครีเอเตอร์ ฟรีแลนซ์ และมืออาชีพไทยใช้บ่อย<br/>
        ประมวลผลบน browser ของคุณ ข้อมูลไม่ออกจากเครื่อง
      </p>
    </div>
  </section>

  <!-- Ad Slot: Top Banner -->
  <div class="mx-auto max-w-6xl px-4 py-4">
    <div class="flex min-h-[90px] items-center justify-center rounded-xl border-2 border-dashed border-gray-200 bg-gray-50 text-center text-xs text-gray-400">
      <div>
        <p class="font-medium">โฆษณา</p>
        <p class="text-gray-300">728×90</p>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 pb-16">

    <!-- Creator Tools -->
    <section class="mt-10">
      <div class="flex items-center gap-3 mb-5">
        <span class="rounded-full bg-purple-100 px-3 py-1 text-xs font-bold text-purple-700 uppercase tracking-wide">ครีเอเตอร์</span>
        <div class="h-px flex-1 bg-gray-200"></div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {creatorTools.map(tool => (
          <a href={tool.href} class="group block rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md">
            <div class="flex items-start gap-4">
              <Icon name={tool.icon} class="h-8 w-8 shrink-0 text-teal-600" />
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <h2 class="text-base font-semibold text-gray-900 group-hover:text-teal-700 transition-colors">{tool.title}</h2>
                  {tool.badge && (
                    <span class={`rounded-full px-2 py-0.5 text-xs font-semibold ${tool.badgeColor}`}>{tool.badge}</span>
                  )}
                </div>
                <p class="mt-1.5 text-sm text-gray-600 leading-relaxed">{tool.desc}</p>
                <span class="mt-3 inline-block text-sm font-semibold text-teal-600 group-hover:text-teal-700">ใช้งานฟรี →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Fun Tools -->
    <section class="mt-10">
      <div class="flex items-center gap-3 mb-5">
        <span class="rounded-full bg-pink-100 px-3 py-1 text-xs font-bold text-pink-700 uppercase tracking-wide">กิจกรรมสนุกๆ</span>
        <div class="h-px flex-1 bg-gray-200"></div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {funTools.map(tool => (
          <a href={tool.href} class="group block rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md">
            <div class="flex items-start gap-4">
              <Icon name={tool.icon} class="h-8 w-8 shrink-0 text-pink-500" />
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <h2 class="text-base font-semibold text-gray-900 group-hover:text-pink-600 transition-colors">{tool.title}</h2>
                  {tool.badge && (
                    <span class={`rounded-full px-2 py-0.5 text-xs font-semibold ${tool.badgeColor}`}>{tool.badge}</span>
                  )}
                </div>
                <p class="mt-1.5 text-sm text-gray-600 leading-relaxed">{tool.desc}</p>
                <span class="mt-3 inline-block text-sm font-semibold text-pink-600 group-hover:text-pink-700">ลองเลย →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Finance Tools -->
    <section class="mt-10">
      <div class="flex items-center gap-3 mb-5">
        <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-700 uppercase tracking-wide">การเงิน & ธุรกิจ</span>
        <div class="h-px flex-1 bg-gray-200"></div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {financeTools.map(tool => (
          <a href={tool.href} class="group block rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md">
            <div class="flex items-start gap-4">
              <Icon name={tool.icon} class="h-8 w-8 shrink-0 text-teal-600" />
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <h2 class="text-base font-semibold text-gray-900 group-hover:text-teal-700 transition-colors">{tool.title}</h2>
                  {tool.badge && (
                    <span class={`rounded-full px-2 py-0.5 text-xs font-semibold ${tool.badgeColor}`}>{tool.badge}</span>
                  )}
                </div>
                <p class="mt-1.5 text-sm text-gray-600 leading-relaxed">{tool.desc}</p>
                <span class="mt-3 inline-block text-sm font-semibold text-teal-600 group-hover:text-teal-700">ใช้งานฟรี →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- General Tools -->
    <section class="mt-10">
      <div class="flex items-center gap-3 mb-5">
        <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-bold text-blue-700 uppercase tracking-wide">เครื่องมือทั่วไป</span>
        <div class="h-px flex-1 bg-gray-200"></div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {generalTools.map(tool => (
          <a href={tool.href} class="group block rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md">
            <div class="flex items-start gap-4">
              <Icon name={tool.icon} class="h-8 w-8 shrink-0 text-teal-600" />
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <h2 class="text-base font-semibold text-gray-900 group-hover:text-teal-700 transition-colors">{tool.title}</h2>
                  {tool.badge && (
                    <span class={`rounded-full px-2 py-0.5 text-xs font-semibold ${tool.badgeColor}`}>{tool.badge}</span>
                  )}
                </div>
                <p class="mt-1.5 text-sm text-gray-600 leading-relaxed">{tool.desc}</p>
                <span class="mt-3 inline-block text-sm font-semibold text-teal-600 group-hover:text-teal-700">ใช้งานฟรี →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Ad Slot: Middle -->
    <div class="mt-10 flex min-h-[90px] items-center justify-center rounded-xl border-2 border-dashed border-gray-200 bg-gray-50 text-center text-xs text-gray-400">
      <div>
        <p class="font-medium">โฆษณา</p>
        <p class="text-gray-300">728×90</p>
      </div>
    </div>

    <!-- Why Drafee -->
    <section class="mt-12 rounded-2xl bg-gradient-to-br from-teal-50 to-cyan-50 border border-teal-100 p-8">
      <h2 class="text-xl font-bold text-gray-900 mb-4">ทำไมต้องใช้ Drafee?</h2>
      <div class="grid gap-4 sm:grid-cols-3 text-sm">
        <div class="flex gap-3">
          <Icon name="lock" class="h-7 w-7 shrink-0 text-teal-600 mt-0.5" />
          <div>
            <p class="font-semibold text-gray-900">ข้อมูลไม่ออกจากเครื่อง</p>
            <p class="text-gray-600 mt-0.5">ทุก tool ประมวลผลบน browser ของคุณ 100% ไม่มีการส่งข้อมูลไปยัง server</p>
          </div>
        </div>
        <div class="flex gap-3">
          <Icon name="bolt" class="h-7 w-7 shrink-0 text-teal-600 mt-0.5" />
          <div>
            <p class="font-semibold text-gray-900">เร็ว ไม่ต้องรอ</p>
            <p class="text-gray-600 mt-0.5">ผลลัพธ์แบบ real-time ไม่ต้องกด submit รอโหลด</p>
          </div>
        </div>
        <div class="flex gap-3">
          <Icon name="gift" class="h-7 w-7 shrink-0 text-teal-600 mt-0.5" />
          <div>
            <p class="font-semibold text-gray-900">ฟรีทั้งหมด ไม่มีเงื่อนไข</p>
            <p class="text-gray-600 mt-0.5">ไม่ต้องสมัครสมาชิก ไม่ต้องให้ email ใช้ได้เลย</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SEO text -->
    <section class="mt-12 prose prose-sm max-w-none text-gray-600">
      <h2 class="text-lg font-bold text-gray-900">เครื่องมือออนไลน์ฟรีสำหรับคนไทย ครบในที่เดียว</h2>
      <p>
        Drafee รวบรวมเครื่องมือที่คนไทยต้องการมากที่สุดไว้ในเว็บเดียว ตั้งแต่เครื่องมือสำหรับ
        <strong>ครีเอเตอร์และคนทำ social media</strong> อย่าง <a href="/ig-line-break" class="text-teal-600 hover:underline">ตัวเว้นบรรทัด Instagram</a>,
        <a href="/character-counter" class="text-teal-600 hover:underline">ตัวนับตัวอักษรทุกแพลตฟอร์ม</a>
        และ <a href="/engagement-rate" class="text-teal-600 hover:underline">เครื่องคำนวณ Engagement Rate</a>
        ไปจนถึงเครื่องมือ<strong>การเงินและภาษี</strong> เช่น
        <a href="/vat-calculator" class="text-teal-600 hover:underline">คำนวณ VAT 7%</a>,
        <a href="/salary-calculator" class="text-teal-600 hover:underline">คำนวณเงินเดือนสุทธิ</a>,
        <a href="/income-tax-calculator" class="text-teal-600 hover:underline">คำนวณภาษีเงินได้บุคคลธรรมดา</a>,
        <a href="/currency-converter" class="text-teal-600 hover:underline">แปลงเงินตรา</a>,
        <a href="/transfer-fee-calculator" class="text-teal-600 hover:underline">เครื่องคำนวณค่าโอนบ้านและที่ดิน</a>
        และ <a href="/withholding-tax-calculator" class="text-teal-600 hover:underline">คำนวณภาษีหัก ณ ที่จ่ายสำหรับฟรีแลนซ์</a>
        รวมถึงเครื่องมือทั่วไปอย่าง <a href="/land-converter" class="text-teal-600 hover:underline">แปลงหน่วยที่ดิน</a>
        และ <a href="/date-calculator" class="text-teal-600 hover:underline">นับวัน คำนวณอายุ</a>
      </p>
      <p>
        เว็บไซต์ออกแบบมาให้โหลดเร็ว รองรับภาษาไทยเต็มรูปแบบ และใช้งานได้บนมือถือ ทุก tool ประมวลผลบน browser ของคุณ 100% ข้อมูลไม่ออกจากเครื่อง ทั้งหมดนี้ฟรี ไม่มีค่าใช้จ่าย ไม่ต้องสมัครสมาชิก
      </p>
    </section>

  </div>

</Layout>
