---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "แปลงหน่วยที่ดิน ไร่ งาน ตารางวา ออนไลน์ฟรี",
  "description": "แปลงหน่วยที่ดิน ไร่ งาน ตารางวา ตารางเมตร ตารางฟุต เฮกตาร์ เอเคอร์ ครบทุกหน่วย",
  "url": "https://drafee.com/land-converter",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "THB" }
});

const units = [
  { id: 'rai',   label: 'ไร่',         toSqm: 1600 },
  { id: 'ngan',  label: 'งาน',         toSqm: 400 },
  { id: 'wa',    label: 'ตารางวา',     toSqm: 4 },
  { id: 'sqm',   label: 'ตารางเมตร',  toSqm: 1 },
  { id: 'sqft',  label: 'ตารางฟุต',   toSqm: 0.09290304 },
  { id: 'acre',  label: 'เอเคอร์',    toSqm: 4046.8564 },
  { id: 'ha',    label: 'เฮกตาร์',   toSqm: 10000 },
];
---

<Layout
  title="แปลงหน่วยที่ดิน ไร่ งาน ตารางวา ตารางเมตร ออนไลน์ฟรี | Drafee"
  description="แปลงหน่วยที่ดินฟรี ไร่ งาน ตารางวา ตารางเมตร ตารางฟุต เฮกตาร์ เอเคอร์ ใส่ค่าหน่วยใดก็ได้ ได้ทุกหน่วยทันที"
  schemaJson={schema}
>
  <div class="bg-gradient-to-b from-teal-50 to-white py-10">
    <div class="mx-auto max-w-2xl px-4 text-center">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-teal-100 px-4 py-1.5 text-sm font-medium text-teal-700">
        <Icon name="squares-2x2" class="h-4 w-4" /> เครื่องมือทั่วไป
      </div>
      <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">แปลงหน่วยที่ดิน</h1>
      <p class="mt-3 text-gray-500">ไร่ · งาน · ตร.วา · ตร.ม. · ตร.ฟุต · เฮกตาร์ · เอเคอร์</p>
    </div>
  </div>

  <div class="mx-auto max-w-2xl px-4 py-8">
    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <p class="mb-4 text-sm text-gray-500">ใส่ค่าในหน่วยใดก็ได้ ระบบจะแปลงให้ทั้งหมดทันที</p>

      <div class="space-y-3" id="converter-fields">
        {units.map((u) => (
          <div class="flex items-center gap-3">
            <label class="w-32 shrink-0 text-sm font-medium text-gray-700">{u.label}</label>
            <input
              id={`field-${u.id}`}
              data-unit={u.id}
              type="number"
              min="0"
              step="any"
              placeholder="0"
              class="w-full rounded-xl border border-gray-300 px-4 py-2.5 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-200"
            />
          </div>
        ))}
      </div>

      <button onclick="clearAll()" class="mt-5 rounded-xl border border-gray-300 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50 transition-colors">
        ล้างค่าทั้งหมด
      </button>
    </div>

    <!-- Reference Table -->
    <div class="mt-6 rounded-2xl border border-gray-200 bg-white p-6">
      <h2 class="mb-4 font-semibold text-gray-900">ตารางอ้างอิง</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="border-b border-gray-100 text-left text-gray-500">
            <th class="pb-2 font-medium">หน่วย</th>
            <th class="pb-2 font-medium">เท่ากับ</th>
          </tr></thead>
          <tbody class="divide-y divide-gray-50 text-gray-700">
            <tr><td class="py-2 font-medium">1 ไร่</td><td class="py-2">= 4 งาน = 400 ตร.วา = 1,600 ตร.ม.</td></tr>
            <tr><td class="py-2 font-medium">1 งาน</td><td class="py-2">= 100 ตร.วา = 400 ตร.ม.</td></tr>
            <tr><td class="py-2 font-medium">1 ตร.วา</td><td class="py-2">= 4 ตร.ม. = 43.056 ตร.ฟุต</td></tr>
            <tr><td class="py-2 font-medium">1 เฮกตาร์</td><td class="py-2">= 10,000 ตร.ม. = 6.25 ไร่</td></tr>
            <tr><td class="py-2 font-medium">1 เอเคอร์</td><td class="py-2">= 4,046.86 ตร.ม. ≈ 2.53 ไร่</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-6 grid gap-2 sm:grid-cols-2">
      <a href="/transfer-fee-calculator" class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:border-teal-300 hover:text-teal-700 transition-colors">
        <Icon name="home" class="h-4 w-4 text-teal-500" /> คำนวณค่าโอนบ้าน-ที่ดิน
      </a>
      <a href="/date-calculator" class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:border-teal-300 hover:text-teal-700 transition-colors">
        <Icon name="calendar" class="h-4 w-4 text-teal-500" /> นับวัน / คำนวณอายุ
      </a>
    </div>
  </div>
</Layout>

<script is:inline>
const units = {
  rai: 1600, ngan: 400, wa: 4, sqm: 1, sqft: 0.09290304, acre: 4046.8564, ha: 10000
};

function convert(sourceId, value) {
  const sqm = value * units[sourceId];
  Object.keys(units).forEach(id => {
    if (id === sourceId) return;
    const el = document.getElementById(`field-${id}`);
    const converted = sqm / units[id];
    el.value = converted === 0 ? '' : +converted.toFixed(8).replace(/\.?0+$/, '');
  });
}

document.querySelectorAll('#converter-fields input').forEach(input => {
  input.addEventListener('input', function() {
    const val = parseFloat(this.value);
    if (!this.value || isNaN(val) || val < 0) {
      document.querySelectorAll('#converter-fields input').forEach(i => { if (i !== this) i.value = ''; });
      return;
    }
    convert(this.dataset.unit, val);
  });
});

function clearAll() {
  document.querySelectorAll('#converter-fields input').forEach(i => i.value = '');
}
</script>
