---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "คำนวณเงินเดือนสุทธิ หักประกันสังคม ภาษี ออนไลน์ฟรี",
  "description": "คำนวณเงินเดือนสุทธิหลังหักประกันสังคม 5% และภาษีเงินได้ ณ ที่จ่าย สำหรับพนักงานประจำ ปีภาษี 2567",
  "url": "https://drafee.com/salary-calculator",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "THB" }
});
---

<Layout
  title="คำนวณเงินเดือนสุทธิ หักประกันสังคม ภาษีเงินได้ ออนไลน์ฟรี | Drafee"
  description="คำนวณเงินเดือนสุทธิฟรี หักประกันสังคม 5% (สูงสุด 750 บาท/เดือน) และภาษีเงินได้หัก ณ ที่จ่าย สำหรับพนักงานประจำ ปีภาษี 2567"
  schemaJson={schema}
>
  <div class="bg-gradient-to-b from-teal-50 to-white py-10">
    <div class="mx-auto max-w-2xl px-4 text-center">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-teal-100 px-4 py-1.5 text-sm font-medium text-teal-700">
        <Icon name="banknotes" class="h-4 w-4" /> เครื่องมือการเงิน
      </div>
      <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">คำนวณเงินเดือนสุทธิ</h1>
      <p class="mt-3 text-gray-500">หักประกันสังคม + ภาษีเงินได้ ณ ที่จ่าย (พนักงานประจำ ปี 2567)</p>
    </div>
  </div>

  <div class="mx-auto max-w-2xl px-4 py-8">
    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="mb-1.5 block text-sm font-medium text-gray-700">เงินเดือน (บาท/เดือน)</label>
          <input id="salary" type="number" min="0" placeholder="เช่น 30000"
            class="w-full rounded-xl border border-gray-300 px-4 py-2.5 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-200" />
        </div>
        <div>
          <label class="mb-1.5 block text-sm font-medium text-gray-700">รายได้เพิ่มเติมต่อเดือน (บาท)</label>
          <input id="extra" type="number" min="0" placeholder="โบนัส ค่าคอม ฯลฯ (ถ้ามี)"
            class="w-full rounded-xl border border-gray-300 px-4 py-2.5 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-200" />
        </div>
      </div>

      <!-- Deductions Section -->
      <div class="mt-5 rounded-xl bg-gray-50 p-4">
        <p class="mb-3 text-sm font-semibold text-gray-700">ค่าลดหย่อนเพิ่มเติม (ต่อปี)</p>
        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <label class="mb-1 block text-xs text-gray-600">กองทุนสำรองเลี้ยงชีพ (บาท/ปี)</label>
            <input id="pvd" type="number" min="0" placeholder="0"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-teal-500 focus:outline-none" />
          </div>
          <div>
            <label class="mb-1 block text-xs text-gray-600">เบี้ยประกันชีวิต (บาท/ปี, ≤100,000)</label>
            <input id="life-ins" type="number" min="0" placeholder="0"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-teal-500 focus:outline-none" />
          </div>
          <div>
            <label class="mb-1 block text-xs text-gray-600">ดอกเบี้ยกู้ซื้อบ้าน (บาท/ปี, ≤100,000)</label>
            <input id="home-loan" type="number" min="0" placeholder="0"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-teal-500 focus:outline-none" />
          </div>
          <div>
            <label class="mb-1 block text-xs text-gray-600">จำนวนบุตร (คน)</label>
            <input id="children" type="number" min="0" max="20" placeholder="0"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-teal-500 focus:outline-none" />
          </div>
        </div>
      </div>

      <button onclick="calculate()"
        class="mt-5 w-full rounded-xl bg-teal-600 py-3 font-semibold text-white transition-colors hover:bg-teal-700">
        <span class="inline-flex items-center gap-2"><Icon name="banknotes" class="h-4 w-4" /> คำนวณเงินเดือนสุทธิ</span>
      </button>

      <!-- Result -->
      <div id="result" class="mt-6 hidden">
        <div class="rounded-xl bg-teal-50 p-5 text-center mb-4">
          <p class="text-sm text-teal-700 mb-1">เงินเดือนสุทธิต่อเดือน</p>
          <p id="val-net" class="text-4xl font-black text-teal-700">—</p>
        </div>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between py-2 border-b border-gray-100">
            <span class="text-gray-600">รายได้รวม/เดือน</span>
            <span id="val-gross" class="font-medium text-gray-900">—</span>
          </div>
          <div class="flex justify-between py-2 border-b border-gray-100">
            <span class="text-gray-600">ประกันสังคม (5%, สูงสุด 750 บ.)</span>
            <span id="val-sso" class="font-medium text-red-600">—</span>
          </div>
          <div class="flex justify-between py-2 border-b border-gray-100">
            <span class="text-gray-600">ภาษีเงินได้หัก ณ ที่จ่าย/เดือน</span>
            <span id="val-wht" class="font-medium text-red-600">—</span>
          </div>
          <div class="flex justify-between py-2">
            <span class="text-gray-600">ภาษีเงินได้ประเมินทั้งปี</span>
            <span id="val-tax-year" class="font-medium text-gray-900">—</span>
          </div>
        </div>
        <div class="mt-4 rounded-xl bg-gray-50 p-4 text-xs text-gray-500 space-y-1">
          <p id="detail-income" class=""></p>
          <p id="detail-deduct" class=""></p>
          <p id="detail-taxable" class=""></p>
        </div>
      </div>
    </div>

    <!-- Info Box -->
    <div class="mt-6 rounded-2xl border border-gray-200 bg-white p-6">
      <h2 class="mb-3 font-semibold text-gray-900">สรุปค่าลดหย่อนมาตรฐาน (ปี 2567)</h2>
      <ul class="space-y-1.5 text-sm text-gray-600">
        <li>• ค่าใช้จ่าย 50% ของรายได้ สูงสุด 100,000 บาท</li>
        <li>• ลดหย่อนส่วนตัว 60,000 บาท</li>
        <li>• ประกันสังคม สูงสุด 9,000 บาท/ปี</li>
        <li>• บุตรคนที่ 1 ลดหย่อน 30,000 บาท, คนที่ 2 ขึ้นไป 60,000 บาท/คน (บุตรที่เกิดตั้งแต่ปี 2561)</li>
      </ul>
    </div>

    <div class="mt-6 grid gap-2 sm:grid-cols-2">
      <a href="/income-tax-calculator" class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:border-teal-300 hover:text-teal-700 transition-colors">
        <Icon name="scale" class="h-4 w-4 text-teal-500" /> ภาษีเงินได้บุคคลธรรมดา (ฉบับเต็ม)
      </a>
      <a href="/withholding-tax-calculator" class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:border-teal-300 hover:text-teal-700 transition-colors">
        <Icon name="calculator" class="h-4 w-4 text-teal-500" /> คำนวณภาษีหัก ณ ที่จ่าย
      </a>
    </div>
  </div>
</Layout>

<script is:inline>
function fmt(n) {
  return n.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' บาท';
}

function calcTax(taxableIncome) {
  const brackets = [
    { min: 0,       max: 150000,  rate: 0 },
    { min: 150000,  max: 300000,  rate: 0.05 },
    { min: 300000,  max: 500000,  rate: 0.10 },
    { min: 500000,  max: 750000,  rate: 0.15 },
    { min: 750000,  max: 1000000, rate: 0.20 },
    { min: 1000000, max: 2000000, rate: 0.25 },
    { min: 2000000, max: 5000000, rate: 0.30 },
    { min: 5000000, max: Infinity, rate: 0.35 },
  ];
  let tax = 0;
  for (const b of brackets) {
    if (taxableIncome <= b.min) break;
    tax += (Math.min(taxableIncome, b.max) - b.min) * b.rate;
  }
  return tax;
}

function calculate() {
  const salary = parseFloat(document.getElementById('salary').value) || 0;
  const extra = parseFloat(document.getElementById('extra').value) || 0;
  const pvd = parseFloat(document.getElementById('pvd').value) || 0;
  const lifeIns = Math.min(parseFloat(document.getElementById('life-ins').value) || 0, 100000);
  const homeLoan = Math.min(parseFloat(document.getElementById('home-loan').value) || 0, 100000);
  const children = parseInt(document.getElementById('children').value) || 0;

  if (salary <= 0) return;

  const monthlyGross = salary + extra;
  const sso = Math.min(salary * 0.05, 750);
  const annualIncome = monthlyGross * 12;

  // Standard deductions
  const expenseDeduct = Math.min(annualIncome * 0.5, 100000);
  const personalDeduct = 60000;
  const ssoDeduct = sso * 12;

  // Child deduction: first child 30,000, 2nd+ 60,000 each (simplified)
  const childDeduct = children > 0 ? 30000 + (children - 1) * 60000 : 0;

  const totalDeduct = expenseDeduct + personalDeduct + ssoDeduct + pvd + lifeIns + homeLoan + childDeduct;
  const taxableIncome = Math.max(0, annualIncome - totalDeduct);
  const annualTax = calcTax(taxableIncome);
  const monthlyWHT = annualTax / 12;
  const netMonthly = monthlyGross - sso - monthlyWHT;

  document.getElementById('val-net').textContent = fmt(netMonthly);
  document.getElementById('val-gross').textContent = fmt(monthlyGross);
  document.getElementById('val-sso').textContent = '- ' + fmt(sso);
  document.getElementById('val-wht').textContent = '- ' + fmt(monthlyWHT);
  document.getElementById('val-tax-year').textContent = fmt(annualTax);
  document.getElementById('detail-income').textContent = `รายได้ต่อปี: ${fmt(annualIncome)}`;
  document.getElementById('detail-deduct').textContent = `ค่าลดหย่อนรวม: ${fmt(totalDeduct)}`;
  document.getElementById('detail-taxable').textContent = `เงินได้สุทธิที่ต้องเสียภาษี: ${fmt(taxableIncome)}`;
  document.getElementById('result').classList.remove('hidden');
}

document.getElementById('salary').addEventListener('keydown', e => { if (e.key === 'Enter') calculate(); });
</script>
